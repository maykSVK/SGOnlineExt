{
  "manifest_version": 3,
  "name": "StarGame pomocnik",
  "version": "0.2.3",
  "description": "Utoky na Valu, vypocet idealneho zaludnenia a lokalny log.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://stargame-online.cz/www/game.php*"],
      "js": ["storage.js", "core.js", "population.js", "sectors.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
